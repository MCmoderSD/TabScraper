{
  "name": "tab-scraper",
  "version": "1.2.1",
  "description": "A Chrome extension to scrape all urls from open tabs and download them as a text file.",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "typescript": "^7.0.2"
  }
}